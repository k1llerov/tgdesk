<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TgDeskBot</AssemblyName>
    <RootNamespace>TgDesk</RootNamespace>
    <Version>1.0.0</Version>
    <Product>TgDesk</Product>
    <Company>k1llerov™</Company>
    <Authors>k1llerov™</Authors>
    <Copyright>© 2026 k1llerov™, MIT License</Copyright>
    <Description>TgDesk bot: Telegram bot, Mini App server and Cloudflare tunnel</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\app\tgdesk.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS8618;CS8625;CS8602;CS8600;CS8604;CS8603;CS8601</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.*" />  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TgDesk.Tests" />
  </ItemGroup>
</Project>
