#include <windows.h>
#include "version.h"

1 ICON "../app/tgdesk.ico"
1 24 "setup.manifest"

1 VERSIONINFO
FILEVERSION SETUP_VER_COMMA
PRODUCTVERSION SETUP_VER_COMMA
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "k1llerov™"
      VALUE "FileDescription", "TgDesk Setup"
      VALUE "ProductName", "TgDesk"
      VALUE "FileVersion", SETUP_VER_STR
      VALUE "ProductVersion", SETUP_VER_STR
      VALUE "LegalCopyright", "© 2026 k1llerov™, MIT License"
      VALUE "OriginalFilename", "TgDesk-Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
