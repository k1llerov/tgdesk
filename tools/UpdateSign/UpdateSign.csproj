<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release signing for TgDesk updates (author only). The same canonical form as the bot: shared source file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\bot\UpdateSignature.cs" Link="UpdateSignature.cs" />
  </ItemGroup>
</Project>
